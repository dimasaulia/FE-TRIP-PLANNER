// Generates src/styles/theme.css from src/styles/tokens.ts.
// Run with `npm run tokens` (Node strips the TypeScript types natively).
import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { tokens, type ThemeName } from "../src/styles/tokens.ts";

const kebab = (value: string) => value.replace(/[A-Z]/g, (char) => `-${char.toLowerCase()}`);

function themeBlock(theme: ThemeName) {
  const lines: string[] = [];
  for (const [name, value] of Object.entries(tokens.color[theme])) {
    lines.push(`--${kebab(name)}: ${value};`);
  }

  const accent = tokens.accent[theme];
  lines.push(`--accent-l: ${accent.l};`, `--accent-c: ${accent.c};`);
  lines.push(`--accent: oklch(var(--accent-l) var(--accent-c) var(--accent-hue));`);
  lines.push(`--accent-soft: oklch(var(--accent-l) var(--accent-c) var(--accent-hue) / 0.12);`);
  lines.push(`--on-accent: ${accent.on};`);

  const note = tokens.note[theme];
  for (const stop of ["top", "mid", "bottom"] as const) {
    lines.push(`--note-${stop}-l: ${note[stop][0]};`, `--note-${stop}-c: ${note[stop][1]};`);
  }
  return lines.map((line) => `  ${line}`).join("\n");
}

const neutralScale = (tokens.note.neutral.chroma / tokens.note.light.mid[1]).toFixed(3);

const shared = [
  `--accent-hue: ${tokens.accent.hue};`,
  `--note-neutral-hue: ${tokens.note.neutral.hue};`,
  `--note-neutral-scale: ${neutralScale};`,
  ...Object.entries(tokens.radius).map(([name, value]) => `--rad-${name}: ${value}px;`),
  ...Object.entries(tokens.space).map(([name, value]) => `--space-${name}: ${value}px;`),
  `--hour-height: ${tokens.timeline.hourHeight}px;`,
  `--gutter-width: ${tokens.timeline.gutterWidth}px;`,
  `--motion-fast: ${tokens.motion.fast}ms;`,
  `--motion-base: ${tokens.motion.base}ms;`,
]
  .map((line) => `  ${line}`)
  .join("\n");

const colorNames = [
  ...Object.keys(tokens.color.light),
  "accent",
  "accentSoft",
  "onAccent",
];

const tailwind = [
  ...colorNames.map((name) => `--color-${kebab(name)}: var(--${kebab(name)});`),
  ...Object.keys(tokens.radius).map((name) => `--radius-${name}: var(--rad-${name});`),
  `--font-sans: var(--font-brand-sans), ui-sans-serif, system-ui, sans-serif;`,
  `--font-mono: var(--font-brand-mono), ui-monospace, monospace;`,
]
  .map((line) => `  ${line}`)
  .join("\n");

const css = `/* Generated by scripts/generate-theme.ts from src/styles/tokens.ts. Do not edit. */
:root {
${shared}
}

:root,
[data-theme="light"] {
  color-scheme: light;
${themeBlock("light")}
}

[data-theme="dark"] {
  color-scheme: dark;
${themeBlock("dark")}
}

@theme inline {
${tailwind}
}
`;

const target = fileURLToPath(new URL("../src/styles/theme.css", import.meta.url));
writeFileSync(target, css);
console.log(`theme written to ${target}`);
