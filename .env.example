# Frontend config. Docker: copy to FE/.env (read at build AND at runtime).
# Local development: copy to .env.local instead.

# Public URL of this frontend, used for absolute links in link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend as seen by Next.js itself (rewrites of /api/* and the server session check).
# Docker Compose: http://be:8081   Local dev: http://localhost:8081
BACKEND_URL=http://localhost:8081
# Browser API base; empty = same origin through the /api rewrite or reverse proxy.
NEXT_PUBLIC_API_GATEWAY_URL=
# WebSocket does not pass through Next.js rewrites. Empty = same origin (reverse proxy
# forwards /api/ incl. WebSocket to the backend). Otherwise e.g. ws://localhost:8081.
NEXT_PUBLIC_WS_URL=
# Shows the password-less login form; only when the backend has DEV_LOGIN_ENABLED=true.
NEXT_PUBLIC_DEV_LOGIN_ENABLED=false
NEXT_PUBLIC_MAX_UPLOAD_BYTES=5242880
