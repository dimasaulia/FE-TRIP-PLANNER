# Public URL of this frontend, used for absolute links in link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend reached by Next.js itself (rewrites of /api/* and the server session check).
BACKEND_URL=http://localhost:8081
# Browser API base; empty = same origin through the /api rewrite.
NEXT_PUBLIC_API_GATEWAY_URL=
# WebSocket does not pass through Next.js rewrites: point it at the backend.
NEXT_PUBLIC_WS_URL=ws://localhost:8081
# Shows the password-less login form; only when the backend has DEV_LOGIN_ENABLED=true.
NEXT_PUBLIC_DEV_LOGIN_ENABLED=false
NEXT_PUBLIC_MAX_UPLOAD_BYTES=5242880
